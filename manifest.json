{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/wudi-7mi/feishu-to-markdown",
  "permissions": [
    "storage",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.feishuapp.cn/*",
    "https://*.larksuite.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/*",
        "https://*.feishuapp.cn/*",
        "https://*.larksuite.com/*"
      ],
      "js": ["converter.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
